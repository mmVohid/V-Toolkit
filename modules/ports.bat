@echo off
rem ======================================================================
rem  modules\ports.bat  -  Port va Lokal Servis menejeri (UI qobig'i)
rem  Matnlar: LANG_UZ / LANG_EN (T_P_*). Mantiq: modules\ports.ps1
rem  Chiqish kodi: 0 = normal, 20 = admin bilan qayta ishga tushirish kerak
rem ======================================================================
setlocal EnableExtensions EnableDelayedExpansion
set "TK_MOD=ports"
call :LANG_!TK_LANG!

powershell -NoProfile -ExecutionPolicy Bypass -File "!TK_ROOT!\modules\ports.ps1"
set "RC=!errorlevel!"

if "!RC!"=="0" endlocal & exit /b 0
if "!RC!"=="20" endlocal & exit /b 20

echo.
call "!TK_C!" :ERR "!T_P_PSFAIL! [code !RC!]"
endlocal & exit /b %RC%

